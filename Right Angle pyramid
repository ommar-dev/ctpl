import java.util.Scanner;
class Right_Pyramid{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        System.out.print("Enter number of Rows: ");
        int n=sc.nextInt();

        for(int i=1;i<n+1;i++){
            for(int star=1;star<=i;star++){
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}
