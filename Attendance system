import java.util.Scanner;
class Student{
    private String name;
    private int rollno;
    private int totalclasses;
    private int attendedclasses;

    // constructor
    public Student(String name,int rollno,int totalclasses,int attendedclasses){
        this.name=name;
        this.rollno=rollno;
        this.totalclasses=totalclasses;
        this.attendedclasses=attendedclasses;
    }
    // method for claculate percentage
    public double claculatepercentage(){
        if(totalclasses==0) return 0.0;
        return ((double)attendedclasses/totalclasses)*100;
    }
    // method for display student detail
    public void displayRecord(){
        double percentage=claculatepercentage();
        System.out.printf("%-10d%-15s%-10d%-15d%.2f%%\n",rollno,name,totalclasses,attendedclasses,percentage);
    }
}
public class AttandanceSystem{
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);

        System.out.print("Enter number of Students: ");
        int n=sc.nextInt();

        Student[] students=new Student[n];

        for(int i=0;i<n;i++){
            System.out.print("\nEnter a detail for student"+(i+1)+": ");
            sc.nextLine();
            System.out.print("Name: ");
            String name=sc.nextLine();
            System.out.print("ROllno: ");
            int roll=sc.nextInt();
            System.out.print("Total Classes held: ");
            int total=sc.nextInt();
            System.out.print("Attended classes: ");
            int attend=sc.nextInt();

            students [i]=new Student(name,roll,total,attend);
        }

        // Displaying details
        System.out.println("\n_________Attendace System_________");
        System.out.printf("%-10s%-10s%-15s%-15s%-10s\n","RollNo","Name","Total Classes","Attend classes","Percentage");
        System.out.println("_______________________________________________________________________");
        for(Student s: students){
            s.displayRecord();
        }
    }
}
