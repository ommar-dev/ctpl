def isPal_prime(n):
    if n<2:
        return False
    if n==2:
        return True
    if n%2==0:
        return False
    
    original=n
    reverse=0
    temp=n

    while temp>0:
        digit=temp%10
        reverse=(reverse*10)+digit
        temp=temp//10

    if original!=reverse:
        return False
    for i in range(2,n):
        if n%i==0:
            return False
    return True

num=int(input("Enter a number: "))
if isPal_prime(num):
    print("number is Palindromic Prime")
else:
    print("number is not Pallindromic Prime")

